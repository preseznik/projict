<Window x:Class="ProJict.App.Views.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Search" Width="680" Height="500" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="16,14">
        <Grid DockPanel.Dock="Top">
            <TextBox x:Name="Query" FontSize="15" TextChanged="Query_TextChanged" PreviewKeyDown="Query_PreviewKeyDown" />
            <TextBlock x:Name="QueryHint" Text="Search items and notes in all projects…" Margin="12,0,0,0" VerticalAlignment="Center"
                       IsHitTestVisible="False" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        </Grid>
        <TextBlock x:Name="Count" DockPanel.Dock="Top" Style="{StaticResource MutedText}" Margin="2,8,0,6" />
        <ListBox x:Name="Results" MouseDoubleClick="Results_MouseDoubleClick" PreviewKeyDown="Results_PreviewKeyDown"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,2">
                        <TextBlock Text="{Binding Snippet}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Style="{StaticResource MutedText}" FontSize="11">
                            <Run Text="{Binding Location, Mode=OneWay}" /><Run Text="{Binding StateText, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
