<Window x:Class="ProJict.App.Views.SharingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ProJict.App.ViewModels"
        xmlns:sharing="clr-namespace:ProJict.App.Services.Sharing"
        Title="Sharing" Width="720" Height="780" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="Row" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="22,16">
        <TextBlock DockPanel.Dock="Top" Text="Sharing" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8" />
        <TabControl>
            <!-- Your projects, for others on your network -->
            <TabItem Header="Share your ProJict">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                    <StackPanel Margin="0,8,0,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <TextBlock Text="Port" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Width="80" Text="{Binding PortText, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                            <CheckBox Content="Let other ProJict apps on your network connect" IsChecked="{Binding IsSharing}" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="{Binding HostStatus}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="2,6,0,0" />
                        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="2,4,0,0" FontSize="12"
                                   Text="Only people you invite and let in can connect, over an encrypted connection. Windows may ask once whether ProJict may use the network: allow it for private networks." />

                        <TextBlock Text="Waiting for you" Style="{StaticResource SectionTitle}" Visibility="{Binding HasRequests, Converter={StaticResource BoolToVis}}" />
                        <ItemsControl ItemsSource="{Binding Requests}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type sharing:JoinRequest}">
                                    <Border Style="{StaticResource Row}">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                                                <Button Content="Let in" Style="{StaticResource AccentButtonStyle}"
                                                        Command="{Binding DataContext.ApproveCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                <Button Content="Deny" Margin="6,0,0,0"
                                                        Command="{Binding DataContext.DenyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                <Button Content="Block" Margin="6,0,0,0"
                                                        Command="{Binding DataContext.BlockCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Invite someone" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Role" Style="{StaticResource MutedText}" VerticalAlignment="Top" Margin="0,6,0,0" />
                            <StackPanel Grid.Column="1">
                                <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding InviteRole}" Width="140" HorizontalAlignment="Left" />
                                <TextBlock Text="{Binding InviteRoleText}" Style="{StaticResource MutedText}" FontSize="12" Margin="2,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Grid.Row="1" Text="Groups" Style="{StaticResource MutedText}" VerticalAlignment="Top" Margin="0,10,0,0" />
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,8,0,0">
                                <ItemsControl ItemsSource="{Binding InviteGroups}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:GroupChoice}">
                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" Margin="0,0,14,4" MinWidth="0" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="None ticked: all groups." Style="{StaticResource MutedText}" FontSize="12" />
                            </StackPanel>
                        </Grid>
                        <Button Content="Create invite" Command="{Binding CreateInviteCommand}" HorizontalAlignment="Left" Margin="110,10,0,0" />
                        <StackPanel Margin="110,8,0,0" Visibility="{Binding NewCodeText, Converter={StaticResource EmptyToVis}}">
                            <TextBox Text="{Binding NewCode, Mode=OneWay}" IsReadOnly="True" FontSize="22" FontFamily="{StaticResource MonoFont}" HorizontalAlignment="Left" MinWidth="170"
                                     Visibility="{Binding NewCode, Converter={StaticResource EmptyToVis}}" />
                            <TextBlock Text="{Binding NewCodeText}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>

                        <TextBlock Text="Open invites" Style="{StaticResource SectionTitle}" Visibility="{Binding HasInvites, Converter={StaticResource BoolToVis}}" />
                        <ItemsControl ItemsSource="{Binding Invites}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:InviteRow}">
                                    <Border Style="{StaticResource Row}">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Revoke" Command="{Binding Revoke}" />
                                            <TextBlock Text="{Binding Code}" FontFamily="{StaticResource MonoFont}" FontSize="15" VerticalAlignment="Center" Width="110" />
                                            <TextBlock Text="{Binding Details}" Style="{StaticResource MutedText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="People" Style="{StaticResource SectionTitle}" Visibility="{Binding HasGuests, Converter={StaticResource BoolToVis}}" />
                        <ItemsControl ItemsSource="{Binding Guests}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:GuestRow}">
                                    <Border Style="{StaticResource Row}">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                                                <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding Role}" Width="134" ToolTip="Changing the role reconnects them" />
                                                <Button Content="{Binding BlockText}" Command="{Binding ToggleBlock}" Margin="6,0,0,0" />
                                                <Button Content="Remove" Command="{Binding Remove}" Margin="6,0,0,0" ToolTip="They'll need a new invite to come back" />
                                            </StackPanel>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Details}" Style="{StaticResource MutedText}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Someone else's projects, here -->
            <TabItem Header="Connect to another ProJict">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                   Text="Enter the address and invite code you were given. Their projects then show in your sidebar under their name, and change live as anyone works on them." />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Address (e.g. 192.168.1.20:47613)" Style="{StaticResource MutedText}" FontSize="12" Margin="2,0,0,4" />
                            <TextBlock Grid.Column="1" Text="Invite code" Style="{StaticResource MutedText}" FontSize="12" Margin="10,0,0,4" />
                            <TextBox Grid.Row="1" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding InviteCode, UpdateSourceTrigger=PropertyChanged}" Margin="10,0,0,0" FontFamily="{StaticResource MonoFont}" />
                            <Button Grid.Row="1" Grid.Column="2" Content="Connect" Style="{StaticResource AccentButtonStyle}" Command="{Binding ConnectCommand}" Margin="10,0,0,0" />
                        </Grid>
                        <!-- First connection: compare the fingerprint with the one shown in their Sharing window. -->
                        <Border Style="{StaticResource Row}" Margin="0,10,0,0" Visibility="{Binding FingerprintToConfirm, Converter={StaticResource EmptyToVis}}"
                                Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap" Text="First connection to this ProJict. Its fingerprint is:" />
                                <TextBlock Text="{Binding FingerprintToConfirm}" FontFamily="{StaticResource MonoFont}" FontSize="15" Margin="0,4" />
                                <TextBlock TextWrapping="Wrap" Style="{StaticResource MutedText}"
                                           Text="Check that it's the one shown in their Sharing window (ask them). If it is, trust it; ProJict then remembers it and warns you if it ever changes." />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="It matches: trust it" Style="{StaticResource AccentButtonStyle}" Command="{Binding TrustCommand}" />
                                    <Button Content="Cancel" Command="{Binding DontTrustCommand}" Margin="8,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding ConnectMessage}" TextWrapping="Wrap" Margin="2,8,0,0" Visibility="{Binding ConnectMessage, Converter={StaticResource EmptyToVis}}" />

                        <TextBlock Text="Your connections" Style="{StaticResource SectionTitle}" Visibility="{Binding HasHosts, Converter={StaticResource BoolToVis}}" />
                        <ItemsControl ItemsSource="{Binding Hosts}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:HostRow}">
                                    <Border Style="{StaticResource Row}">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                                                <Button Content="Disconnect" Command="{Binding Disconnect}" Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />
                                                <Button Content="Connect" Command="{Binding Reconnect}" Visibility="{Binding IsActive, Converter={StaticResource InvBoolToVis}}" />
                                                <Button Content="Remove" Command="{Binding Forget}" Margin="6,0,0,0" ToolTip="Forget this ProJict; you'd need a new invite" />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding StateText}" Style="{StaticResource MutedText}" FontSize="12" />
                                                <TextBlock Text="{Binding Message}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" FontSize="12" TextWrapping="Wrap"
                                                           Visibility="{Binding Message, Converter={StaticResource EmptyToVis}}" />
                                                <CheckBox Content="Connect when ProJict starts" IsChecked="{Binding AutoConnect}" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
