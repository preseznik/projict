<UserControl x:Class="ProJict.App.Views.AgentActivityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ProJict.App.ViewModels">
    <UserControl.Resources>
        <!-- Three dots that light up in turn while an agent is busy. -->
        <Style x:Key="Dot" TargetType="Ellipse">
            <Setter Property="Width" Value="6" />
            <Setter Property="Height" Value="6" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Fill" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            <Setter Property="Opacity" Value="0.25" />
        </Style>

        <DataTemplate x:Key="AgentCard" DataType="{x:Type vm:AgentCardViewModel}">
            <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,10">
                <StackPanel>
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="17" Background="{Binding Badge.Background}" Margin="0,0,12,0" VerticalAlignment="Top">
                            <TextBlock Text="{Binding Badge.Initials}" Foreground="White" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Where}" Style="{StaticResource MutedText}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <!-- Live: what it's doing now. -->
                    <Border x:Name="StatusBox" CornerRadius="6" Padding="10,8" Margin="0,12,0,0" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding StatusAge}" Style="{StaticResource MutedText}" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0" />
                            <StackPanel x:Name="Dots" DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Collapsed">
                                <Ellipse x:Name="Dot1" Style="{StaticResource Dot}" />
                                <Ellipse x:Name="Dot2" Style="{StaticResource Dot}" />
                                <Ellipse x:Name="Dot3" Style="{StaticResource Dot}" />
                            </StackPanel>
                            <TextBlock x:Name="IdleGlyph" DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE916;" FontSize="12" Margin="0,1,8,0"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="StatusLine" Text="{Binding StatusText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>

                    <!-- What it has checked out. -->
                    <StackPanel Margin="0,10,0,0" Visibility="{Binding HasCheckedOut, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Checked out" Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,4" />
                        <ItemsControl ItemsSource="{Binding CheckedOut}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:CheckoutRow}">
                                    <Border x:Name="Row" Padding="6,4" CornerRadius="4" Background="Transparent" Cursor="Hand" ToolTip="Show it on the board">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" Command="{Binding OpenCommand}" />
                                        </Border.InputBindings>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Project}" Style="{StaticResource MutedText}" FontSize="12" Margin="10,0,0,0" />
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="11" Margin="0,2,8,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                            <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Its latest actions, newest first. -->
                    <StackPanel Margin="0,10,0,0" Visibility="{Binding HasRecent, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Lately" Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,2" />
                        <ItemsControl ItemsSource="{Binding Recent}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:AgentActionRow}">
                                    <Grid x:Name="Row" Margin="0,3,0,0" Opacity="0.7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="74" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Age}" ToolTip="{Binding Time}" Style="{StaticResource MutedText}" FontSize="12" />
                                        <TextBlock Grid.Column="1" Text="{Binding Text}" TextTrimming="CharacterEllipsis" FontSize="13" />
                                        <TextBlock Grid.Column="2" Text="{Binding Project}" Style="{StaticResource MutedText}" FontSize="12" Margin="10,0,0,0" />
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsLatest}" Value="True">
                                            <Setter TargetName="Row" Property="Opacity" Value="1" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter TargetName="Dots" Property="Visibility" Value="Visible" />
                    <Setter TargetName="IdleGlyph" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="StatusLine" Property="FontWeight" Value="SemiBold" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="Busy">
                            <Storyboard RepeatBehavior="Forever" Duration="0:0:1.3">
                                <DoubleAnimation Storyboard.TargetName="Dot1" Storyboard.TargetProperty="Opacity" From="0.25" To="1" Duration="0:0:0.35" AutoReverse="True" />
                                <DoubleAnimation Storyboard.TargetName="Dot2" Storyboard.TargetProperty="Opacity" From="0.25" To="1" Duration="0:0:0.35" AutoReverse="True" BeginTime="0:0:0.2" />
                                <DoubleAnimation Storyboard.TargetName="Dot3" Storyboard.TargetProperty="Opacity" From="0.25" To="1" Duration="0:0:0.35" AutoReverse="True" BeginTime="0:0:0.4" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="Busy" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Older agent work, greyed out; a click goes where it happened. -->
        <DataTemplate x:Key="HistoryRow" DataType="{x:Type vm:AgentHistoryRow}">
            <StackPanel>
            <TextBlock Text="{Binding DayHeader}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="8,10,0,2"
                       Visibility="{Binding DayHeader, Converter={StaticResource EmptyToVis}}" />
            <Border x:Name="EntryRoot" Padding="8,6" CornerRadius="6" Background="Transparent" Cursor="Hand" Opacity="0.6">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding OpenCommand}" />
                </Border.InputBindings>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding When}" ToolTip="{Binding WhenToolTip}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,1,0,0" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1">
                        <TextBlock TextWrapping="Wrap">
                            <Run Text="{Binding Who, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" " /><Run Text="{Binding Action, Mode=OneWay}" />
                            <Run Text="{Binding Subject, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" FontSize="12" TextTrimming="CharacterEllipsis" MaxHeight="36" TextWrapping="Wrap"
                                   Visibility="{Binding Detail, Converter={StaticResource EmptyToVis}}" />
                        <TextBlock Text="{Binding Where}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,1,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
            </StackPanel>
            <DataTemplate.Triggers>
                <Trigger SourceName="EntryRoot" Property="IsMouseOver" Value="True">
                    <Setter TargetName="EntryRoot" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                    <Setter TargetName="EntryRoot" Property="Opacity" Value="0.9" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- A day, week or month of earlier agent work: its heading, its stats when opened, and its entries unless folded. -->
        <DataTemplate x:Key="HistoryGroup" DataType="{x:Type vm:ActivityGroupViewModel}">
            <StackPanel>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ActivityGroupHeader}" Focusable="False" />
                <ContentControl Content="{Binding Stats}" ContentTemplate="{StaticResource ActivityStatsPanel}" Focusable="False"
                                Visibility="{Binding IsStatsOpen, Converter={StaticResource BoolToVis}}" />
                <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource HistoryRow}" Focusable="False"
                              Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <!-- As wide as the window allows, up to 980: the stats and their charts get the room. -->
        <Grid Margin="28,20,28,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="980" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
        <StackPanel>
            <DockPanel>
                <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding ProjectChoices}" SelectedItem="{Binding ProjectFilter}" Width="200" VerticalAlignment="Center"
                          AutomationProperties.Name="Project" ToolTip="Only agents working in this project" />
                <StackPanel>
                    <TextBlock Text="Agents" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>

            <TextBlock Text="Working now" Style="{StaticResource SectionTitle}" Margin="0,20,0,8" />
            <Border Style="{StaticResource Card}" Padding="16,14" Visibility="{Binding HasLive, Converter={StaticResource InvBoolToVis}}">
                <TextBlock Text="{Binding EmptyText}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
            </Border>
            <ItemsControl x:Name="LiveCards" ItemsSource="{Binding Live}" ItemTemplate="{StaticResource AgentCard}" Focusable="False" />
            <TextBlock Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="2,0,0,0"
                       Text="Agents can say what they're busy with (set_status); otherwise this shows what they last did here. The dots move while an agent is active." />

            <DockPanel Margin="0,24,0,0" Visibility="{Binding HasHistory, Converter={StaticResource BoolToVis}}">
                <ComboBox DockPanel.Dock="Right" ItemsSource="{x:Static vm:GroupingOption.All}" SelectedItem="{Binding Grouping}" DisplayMemberPath="Label" Width="130"
                          VerticalAlignment="Center" AutomationProperties.Name="Group by" ToolTip="Group earlier agent work by day, week or month; each has its own stats" />
                <Button DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Content="{Binding FoldAllText}" Command="{Binding FoldAllCommand}" Margin="0,0,8,0"
                        ToolTip="Fold or open every period" />
                <TextBlock Text="Earlier" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
            </DockPanel>
            <ItemsControl x:Name="HistoryList" ItemsSource="{Binding HistoryGroups}" ItemTemplate="{StaticResource HistoryGroup}" Focusable="False" />
            <Button Content="Show more" HorizontalAlignment="Left" Margin="0,12,0,0" Command="{Binding ShowMoreHistoryCommand}"
                    Visibility="{Binding HasMoreHistory, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
