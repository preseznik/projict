<Window x:Class="ProJict.App.Views.QuickCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ProJict — quick capture" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Topmost="True" ShowInTaskbar="False" Icon="pack://application:,,,/Assets/ProJict.ico">
    <StackPanel Margin="18,14">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="ProjectBox" DisplayMemberPath="Name" SelectionChanged="ProjectBox_SelectionChanged" ToolTip="Project" />
            <ComboBox x:Name="CategoryBox" Grid.Column="2" IsEditable="True" ToolTip="Category (type a new name to create one)" />
        </Grid>
        <TextBox x:Name="ItemText" Margin="0,10,0,0" FontSize="15" PreviewKeyDown="ItemText_PreviewKeyDown" />
        <TextBlock x:Name="Hint" Style="{StaticResource MutedText}" FontSize="11" Margin="2,8,0,0" TextWrapping="Wrap"
                   Text="Enter add · Shift+Enter add and keep open · Esc close · prefix BUG: / ADD: to tag · start with + to add as done" />
    </StackPanel>
</Window>
