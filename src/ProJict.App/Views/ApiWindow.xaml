<Window x:Class="ProJict.App.Views.ApiWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ProJict.App.ViewModels"
        Title="API" Width="720" Height="800" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="Row" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="Code" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="22,16">
        <TextBlock DockPanel.Dock="Top" Text="API" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Close" IsCancel="True" MinWidth="90" Click="Close_Click" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
            <StackPanel>
                <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                           Text="Another way for AI agents, scripts and tools such as n8n to work in ProJict: a REST API and the same tools as over MCP. Every request needs a token. What's done with a token is signed with its name, follows your AI agent limits (Settings › AI agents) and waits for your review; nothing can be deleted, and web pages in a browser can't call it." />

                <DockPanel Margin="0,12,0,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBlock Text="Port" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox x:Name="Port" Width="80" Text="{Binding PortText, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Port" />
                    </StackPanel>
                    <CheckBox x:Name="TurnOn" Content="Turn on ProJict's API" IsChecked="{Binding IsOn}" VerticalAlignment="Center" />
                </DockPanel>
                <CheckBox x:Name="Network" Content="Also let other devices on my network connect (over HTTPS)" IsChecked="{Binding AllowNetwork}" Margin="0,6,0,0" />
                <TextBlock x:Name="Status" Text="{Binding Status}" TextWrapping="Wrap" Margin="2,8,0,0" />
                <TextBox x:Name="Endpoints" Style="{StaticResource Code}" Text="{Binding Endpoints, Mode=OneWay}" Margin="0,8,0,0"
                         Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="Addresses" />
                <DockPanel Margin="0,8,0,0" Visibility="{Binding HasCertificate, Converter={StaticResource BoolToVis}}">
                    <Button DockPanel.Dock="Right" Content="Save certificate…" Margin="8,0,0,0" VerticalAlignment="Top" Click="SaveCertificate_Click" />
                    <TextBlock Text="{Binding CertificateText}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                </DockPanel>
                <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="2,6,0,0" FontSize="12"
                           Text="ProJict opens nothing to the internet. For web-based connectors (claude.ai, cloud automations), put a tunnel in front of it, such as Cloudflare Tunnel; the README explains. For agents on this computer, the MCP setup under Settings › AI agents stays the simplest way." />

                <!-- A token just made or renewed, shown once -->
                <Border x:Name="SecretCard" Style="{StaticResource Card}" Padding="12,10" Margin="0,14,0,0"
                        Visibility="{Binding HasSecret, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="{Binding SecretTitle}" TextWrapping="Wrap" FontWeight="SemiBold" />
                        <DockPanel Margin="0,8,0,0">
                            <Button DockPanel.Dock="Right" Content="Copy" MinWidth="70" Margin="8,0,0,0" Click="CopySecret_Click" />
                            <TextBox x:Name="SecretText" Style="{StaticResource Code}" Text="{Binding Secret, Mode=OneWay}" AutomationProperties.Name="Token" />
                        </DockPanel>
                        <TextBlock Text="For example, with curl, and to add it to Claude Code:" Style="{StaticResource MutedText}" Margin="2,10,0,4" />
                        <TextBox Style="{StaticResource Code}" Text="{Binding SecretExamples, Mode=OneWay}" AutomationProperties.Name="Examples" />
                        <Button Content="Done" HorizontalAlignment="Right" MinWidth="90" Margin="0,10,0,0" Command="{Binding DismissSecretCommand}" />
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding TokensTitle}" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="No tokens yet." Style="{StaticResource MutedText}" Visibility="{Binding HasTokens, Converter={StaticResource InvBoolToVis}}" />
                <ItemsControl x:Name="TokenList" ItemsSource="{Binding Tokens}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TokenRow}">
                            <Border Style="{StaticResource Row}">
                                <StackPanel>
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top"
                                                    Visibility="{Binding IsConfirming, Converter={StaticResource InvBoolToVis}}">
                                            <Button Content="Renew" Command="{Binding AskRenewCommand}"
                                                    ToolTip="A new token with the same settings, for the same time again; the current one stops working" />
                                            <Button Content="Revoke" Margin="6,0,0,0" Command="{Binding AskRevokeCommand}" ToolTip="Stops it working right away" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock>
                                                <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                                                <Run Text="{Binding Masked, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Details}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                            <TextBlock TextWrapping="Wrap" Margin="0,2,0,0" FontSize="12">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding NeedsRenewal}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                                <Run Text="{Binding ExpiresText, Mode=OneWay}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding LastUsedText, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                    <DockPanel Margin="0,8,0,0" Visibility="{Binding IsConfirming, Converter={StaticResource BoolToVis}}">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Content="{Binding ConfirmLabel}" Style="{StaticResource AccentButtonStyle}" Command="{Binding ConfirmCommand}" />
                                            <Button Content="Cancel" Margin="6,0,0,0" Command="{Binding CancelCommand}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding ConfirmText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="New token" Style="{StaticResource SectionTitle}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Name" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                    <TextBox x:Name="NewName" Grid.Column="1" Width="260" HorizontalAlignment="Left" Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Token name" ToolTip="What will use it, e.g. n8n. Everything done with the token is signed with this name." />

                    <TextBlock Grid.Row="1" Text="Access" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,8,0,0" />
                    <ComboBox Grid.Row="1" Grid.Column="1" Width="180" HorizontalAlignment="Left" Margin="0,8,0,0" ItemsSource="{Binding AccessChoices}"
                              SelectedItem="{Binding NewAccess}" DisplayMemberPath="Label" AutomationProperties.Name="Access" />

                    <TextBlock Grid.Row="2" Text="Projects" Style="{StaticResource MutedText}" VerticalAlignment="Top" Margin="0,12,0,0" />
                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,8,0,0">
                        <RadioButton Content="All my projects" IsChecked="{Binding AllProjects}" GroupName="TokenProjects" />
                        <RadioButton x:Name="SomeProjects" Content="Only these:" GroupName="TokenProjects"
                                     IsChecked="{Binding AllProjects, Converter={StaticResource InvBool}}" />
                        <ItemsControl x:Name="ProjectList" ItemsSource="{Binding ProjectChoices}" Focusable="False" Margin="24,4,0,0"
                                      Visibility="{Binding IsChecked, ElementName=SomeProjects, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ProjectChoice}">
                                    <CheckBox IsChecked="{Binding IsChecked}" Margin="0,0,14,4" MinWidth="0" AutomationProperties.Name="{Binding Name}">
                                        <TextBlock Text="{Binding Name}" />
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <TextBlock Grid.Row="3" Text="Expires after" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,8,0,0" />
                    <ComboBox Grid.Row="3" Grid.Column="1" Width="180" HorizontalAlignment="Left" Margin="0,8,0,0" ItemsSource="{Binding ExpiryChoices}"
                              SelectedItem="{Binding NewExpiry}" DisplayMemberPath="Label" AutomationProperties.Name="Expires after" />
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="110,12,0,0">
                    <Button x:Name="Create" Content="Make token" Style="{StaticResource AccentButtonStyle}" MinWidth="110" Command="{Binding CreateTokenCommand}" />
                    <TextBlock Text="{Binding NewError}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap"
                               VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
