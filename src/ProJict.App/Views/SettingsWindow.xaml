<Window x:Class="ProJict.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="640" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="22,16">
        <TextBlock DockPanel.Dock="Top" Text="Settings" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4" />
        <StackPanel DockPanel.Dock="Bottom">
            <TextBlock x:Name="Error" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Margin="0,12,0,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Open data folder" MinWidth="120" Click="OpenData_Click" />
                <Button Content="Save" Style="{StaticResource AccentButtonStyle}" IsDefault="True" MinWidth="100" Margin="8,0,0,0" Click="Save_Click" />
                <Button Content="Cancel" IsCancel="True" MinWidth="90" Margin="8,0,0,0" />
            </StackPanel>
        </StackPanel>
        <!-- The sections scroll when the screen is too short for all of them; Save and Cancel stay in view. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
        <StackPanel>

        <TextBlock Text="Data" Style="{StaticResource SectionTitle}" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Browse…" Margin="8,0,0,0" Click="BrowseData_Click" />
            <TextBox x:Name="DataRoot" />
        </DockPanel>
        <TextBlock Style="{StaticResource MutedText}" Margin="2,4,0,0" TextWrapping="Wrap"
                   Text="One JSON file per project plus rolling backups. Changing this takes effect after restarting ProJict." />

        <TextBlock Text="TXT mirror" Style="{StaticResource SectionTitle}" />
        <CheckBox x:Name="MirrorEnabled" Content="Keep TODO-/DONE- text files continuously up to date in this folder" />
        <DockPanel Margin="0,6,0,0">
            <Button DockPanel.Dock="Right" Content="Browse…" Margin="8,0,0,0" Click="BrowseMirror_Click" />
            <TextBox x:Name="MirrorFolder" />
        </DockPanel>
        <TextBlock Style="{StaticResource MutedText}" Margin="2,4,0,0" TextWrapping="Wrap"
                   Text="Handy for grep and AI agents that read plain text. Files ProJict did not write (e.g. your archived originals) are never overwritten by the mirror." />

        <TextBlock Text="Quick capture &amp; window" Style="{StaticResource SectionTitle}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Global hotkey" VerticalAlignment="Center" />
            <TextBox x:Name="Hotkey" Grid.Column="1" IsReadOnly="True" PreviewKeyDown="Hotkey_PreviewKeyDown"
                     ToolTip="Click here and press the key combination (e.g. Ctrl+Alt+J)" />
            <Button Grid.Column="2" Content="Disable" Margin="8,0,0,0" Click="ClearHotkey_Click" />
        </Grid>
        <CheckBox x:Name="CloseToTray" Content="Closing the window keeps ProJict running in the tray" Margin="0,8,0,0" />

        <TextBlock Text="Board &amp; prompts" Style="{StaticResource SectionTitle}" />
        <CheckBox x:Name="MarkInProgress" Content="Mark items as in progress when copied as a prompt" />
        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Theme" VerticalAlignment="Center" />
            <ComboBox x:Name="Theme" Grid.Column="1" Width="160" HorizontalAlignment="Left">
                <ComboBoxItem Content="System" />
                <ComboBoxItem Content="Light" />
                <ComboBoxItem Content="Dark" />
            </ComboBox>
            <TextBlock Grid.Row="1" Text="Stale after (days)" VerticalAlignment="Center" Margin="0,8,0,0" />
            <TextBox x:Name="StaleDays" Grid.Row="1" Grid.Column="1" Width="80" HorizontalAlignment="Left" Margin="0,8,0,0" />
            <TextBlock Grid.Row="2" Text="Groups" VerticalAlignment="Center" Margin="0,8,0,0" />
            <TextBox x:Name="Groups" Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" ToolTip="Comma separated, in sidebar order. Personal and Work always stay." />
            <TextBlock Grid.Row="3" Text="VS Code (Code.exe)" VerticalAlignment="Center" Margin="0,8,0,0" />
            <DockPanel Grid.Row="3" Grid.Column="1" Margin="0,8,0,0">
                <Button DockPanel.Dock="Right" Content="Browse…" Margin="8,0,0,0" Click="BrowseCode_Click" />
                <TextBox x:Name="VsCodePath" ToolTip="Leave empty to auto-detect" />
            </DockPanel>
        </Grid>

        <TextBlock Text="GitHub" Style="{StaticResource SectionTitle}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Account" VerticalAlignment="Center" />
            <DockPanel Grid.Column="1">
                <Button x:Name="CheckReleases" DockPanel.Dock="Right" Content="Check releases now" Margin="8,0,0,0" Click="CheckReleases_Click" />
                <TextBox x:Name="GitHubAccount" ToolTip="Your GitHub user or organization. Its repositories are linked to projects with the same name; a project's own GitHub link (Details) always wins." />
            </DockPanel>
        </Grid>
        <CheckBox x:Name="UseGitHubCli" Content="Use my GitHub CLI (gh) sign-in, so private repositories are included" Margin="0,8,0,0" />
        <TextBlock x:Name="ReleasesResult" Style="{StaticResource MutedText}" FontSize="13" TextWrapping="Wrap" Margin="2,6,0,0" />

        <TextBlock Text="AI agents &amp; comments" Style="{StaticResource SectionTitle}" />
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Your name" VerticalAlignment="Center" />
            <TextBox x:Name="UserName" Grid.Column="1" Width="220" HorizontalAlignment="Left"
                     ToolTip="How you sign comments, notes and history entries. Empty uses your Windows user name." />
        </Grid>
        <CheckBox x:Name="AllowAgents" Content="Let AI agents (Claude Code and other MCP clients) work in ProJict" />
        <TextBlock Style="{StaticResource MutedText}" Margin="2,4,0,0" TextWrapping="Wrap"
                   Text="Agents can check out and complete items, add items, comment, attach files and write notes, but never delete anything; what they finish waits for your review, and Ctrl+Z undoes their changes." />
        <!-- How to add ProJict to each agent; folded away once it's set up. -->
        <Expander x:Name="ConnectAgent" Header="Connect an AI agent (Claude Code, Codex, OpenCode, …)" Margin="0,8,0,0">
            <StackPanel Margin="0,8,0,0">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Copy" MinWidth="70" Margin="8,0,0,0" Click="CopyMcpCommand_Click" />
                    <ComboBox x:Name="AgentClient" Width="280" HorizontalAlignment="Left" DisplayMemberPath="Client"
                              SelectionChanged="AgentClient_SelectionChanged" AutomationProperties.Name="AI agent" />
                </DockPanel>
                <TextBox x:Name="McpCommand" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" FontFamily="{StaticResource MonoFont}" FontSize="12"
                         MaxHeight="170" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0" />
                <TextBlock x:Name="McpWhere" Style="{StaticResource MutedText}" Margin="2,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Expander>

        <TextBlock Text="Updates" Style="{StaticResource SectionTitle}" />
        <CheckBox x:Name="CheckUpdates" Content="Check for updates when ProJict starts, and every 4 hours while it's open" />
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button x:Name="CheckNow" Content="Check now" MinWidth="100" Click="CheckNow_Click" />
            <TextBlock x:Name="UpdateResult" Style="{StaticResource MutedText}" FontSize="13" Margin="12,0,0,0" TextWrapping="Wrap" />
        </StackPanel>
        <!-- DataContext is the update service; shown while a newer version is available. -->
        <Border x:Name="UpdatePanel" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="12,10"
                Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" Margin="0,0,10,0" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ProgressBar Width="120" Height="4" Margin="0,0,12,0" Value="{Binding Progress, Mode=OneWay}" Maximum="100"
                                 Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}" />
                    <Button Style="{StaticResource SubtleButton}" Content="What's new" Command="{Binding ShowNotesCommand}" />
                    <Button Style="{StaticResource AccentButtonStyle}" Content="Install update" Command="{Binding InstallCommand}" Margin="6,0,0,0"
                            IsEnabled="{Binding IsDownloading, Converter={StaticResource InvBool}}"
                            ToolTip="Downloads the installer, closes ProJict, updates it and starts it again" />
                </StackPanel>
                <TextBlock Text="{Binding BannerText}" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
        </Border>
        <TextBlock x:Name="VersionText" Style="{StaticResource MutedText}" Margin="2,8,0,0" />
        </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
