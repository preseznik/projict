<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:ProJict.App"
                    xmlns:vm="clr-namespace:ProJict.App.ViewModels"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

    <local:BoolToVisibilityConverter x:Key="BoolToVis" />
    <local:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True" />
    <local:InverseBoolConverter x:Key="InvBool" />
    <local:EmptyToVisibilityConverter x:Key="EmptyToVis" />
    <local:EmptyToVisibilityConverter x:Key="InvEmptyToVis" Invert="True" />
    <local:StatusToBrushConverter x:Key="StatusToBrush" />
    <local:TagToBrushConverter x:Key="TagToBrush" />
    <local:PriorityToBrushConverter x:Key="PriorityToBrush" />
    <local:GroupExpandedConverter x:Key="GroupExpanded" />
    <local:GroupCommentCountConverter x:Key="GroupCommentCount" />

    <Style x:Key="MutedText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Margin" Value="0,12,0,6" />
    </Style>

    <Style x:Key="Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,8" />
    </Style>

    <!-- Borderless button that only shows a fill on hover; Content is usually an icon glyph. -->
    <Style x:Key="SubtleButton" TargetType="ButtonBase">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Padding" Value="7,5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SubtleIconButton" TargetType="Button" BasedOn="{StaticResource SubtleButton}">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="14" />
    </Style>
    <Style x:Key="SubtleToggle" TargetType="ToggleButton" BasedOn="{StaticResource SubtleButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}"
                            BorderThickness="1" BorderBrush="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sidebar navigation button. -->
    <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource SubtleButton}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="Tag">
                            <Trigger.Value>
                                <sys:Boolean>True</sys:Boolean>
                            </Trigger.Value>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Flat, outliner-style text box used for item rows and inline headers. -->
    <Style x:Key="RowTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="5,3" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="AcceptsReturn" Value="False" />
        <Setter Property="AcceptsTab" Value="False" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="40" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Padding="0" Margin="0"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                        </Border>
                        <TextBlock x:Name="Hint" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                   Margin="{TemplateBinding Padding}" Padding="2,0,0,0" IsHitTestVisible="False" Visibility="Collapsed"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                        </Trigger>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Like RowTextBox, but an empty box (and its hint) only shows while hovered or focused. -->
    <Style x:Key="HoverHintTextBox" TargetType="TextBox" BasedOn="{StaticResource RowTextBox}">
        <Style.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Text" Value="" />
                    <Condition Property="IsMouseOver" Value="False" />
                    <Condition Property="IsKeyboardFocused" Value="False" />
                </MultiTrigger.Conditions>
                <Setter Property="Opacity" Value="0" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <!-- Text that reads like a TextBlock but can be selected and copied (Ctrl+C, right-click › Copy). Its host is a plain
         Decorator rather than a ScrollViewer, so the mouse wheel still scrolls whatever the text sits in. -->
    <Style x:Key="SelectableText" TargetType="TextBox">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Decorator x:Name="PART_ContentHost" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A red dot: a comment you haven't read, or something else waiting for you. -->
    <Style x:Key="UnreadDot" TargetType="Ellipse">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="TagChip" TargetType="Border">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="5,1" />
        <Setter Property="Margin" Value="2,0,2,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="ChipText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
    </Style>

    <!-- Who is working in a project: overlapping round badges with initials (see WorkerBadge). -->
    <ItemsPanelTemplate x:Key="WorkerBadgePanel">
        <StackPanel Orientation="Horizontal" Margin="4,0,0,0" />
    </ItemsPanelTemplate>
    <DataTemplate x:Key="WorkerBadgeTemplate">
        <Border Width="16" Height="16" CornerRadius="8" Margin="-4,0,0,0" Background="{Binding Background}"
                BorderBrush="{DynamicResource SolidBackgroundFillColorBaseBrush}" BorderThickness="1.5">
            <TextBlock Text="{Binding Initials}" FontSize="7" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
    </DataTemplate>

    <!-- Timelines grouped by period (Feed, Agents). People's activity is drawn in the accent color, AI agents' in this. -->
    <SolidColorBrush x:Key="AgentActivityBrush" Color="#D97757" />

    <!-- A period's heading: a click on its name folds it; Stats opens its numbers and charts, apart from that. -->
    <DataTemplate x:Key="ActivityGroupHeader" DataType="{x:Type vm:ActivityGroupViewModel}">
        <DockPanel Margin="0,14,0,4">
            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource SubtleToggle}" IsChecked="{Binding IsStatsOpen}" Padding="8,4"
                          ToolTip="What went on in this period, in numbers and charts" AutomationProperties.Name="Stats">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE9D2;" FontSize="13" Margin="0,0,6,0" />
                    <TextBlock Text="Stats" FontSize="12" />
                </StackPanel>
            </ToggleButton>
            <Button Style="{StaticResource SubtleButton}" Command="{Binding ToggleExpandedCommand}" HorizontalAlignment="Left" Padding="6,4"
                    ToolTip="{Binding ExpandToolTip}" AutomationProperties.Name="{Binding Label}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="Chevron" Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="10" Margin="0,1,10,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{Binding Label}" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding CountText}" Style="{StaticResource MutedText}" Margin="12,2,0,0" />
                    <TextBlock Text="{Binding CutText}" Style="{StaticResource MutedText}" FontStyle="Italic" Margin="8,2,0,0"
                               Visibility="{Binding CutText, Converter={StaticResource EmptyToVis}}" />
                </StackPanel>
            </Button>
        </DockPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                <Setter TargetName="Chevron" Property="Text" Value="&#xE76C;" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- A bar in a period's stats: a kind, project or person, people's share then agents', and the count. -->
    <DataTemplate x:Key="StatBarRow" DataType="{x:Type vm:StatBar}">
        <Grid Margin="0,2" Background="Transparent" ToolTip="{Binding ToolTip}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="32" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Label}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <Grid Grid.Column="1" Height="8" Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding People}" />
                    <ColumnDefinition Width="{Binding Agents}" />
                    <ColumnDefinition Width="{Binding Rest}" />
                </Grid.ColumnDefinitions>
                <Border Background="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="2" />
                <Border Grid.Column="1" Background="{StaticResource AgentActivityBrush}" CornerRadius="2" />
            </Grid>
            <TextBlock Grid.Column="2" Text="{Binding Count}" Style="{StaticResource MutedText}" HorizontalAlignment="Right" />
        </Grid>
    </DataTemplate>

    <!-- A period's stats: the numbers, a chart of when (by hour or day), and bars for what, where and who. -->
    <DataTemplate x:Key="ActivityStatsPanel" DataType="{x:Type vm:ActivityStatsViewModel}">
        <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,2,0,10">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Tiles}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:StatTile}">
                            <StackPanel Margin="0,0,32,8" Background="Transparent" ToolTip="{Binding ToolTip}">
                                <TextBlock Text="{Binding Value}" FontSize="22" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Label}" Style="{StaticResource MutedText}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding FilterNote}" Style="{StaticResource MutedText}" FontStyle="Italic" Margin="0,0,0,4"
                           Visibility="{Binding FilterNote, Converter={StaticResource EmptyToVis}}" />
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="8" Height="8" CornerRadius="2" Background="{DynamicResource AccentFillColorDefaultBrush}" Margin="0,0,5,0"
                                        Visibility="{Binding AgentsOnly, Converter={StaticResource InvBoolToVis}}" />
                                <TextBlock Text="People" Style="{StaticResource MutedText}" Margin="0,0,12,0"
                                           Visibility="{Binding AgentsOnly, Converter={StaticResource InvBoolToVis}}" />
                                <Border Width="8" Height="8" CornerRadius="2" Background="{StaticResource AgentActivityBrush}" Margin="0,0,5,0" />
                                <TextBlock Text="AI agents" Style="{StaticResource MutedText}" />
                            </StackPanel>
                            <TextBlock Text="{Binding ChartTitle}" Style="{StaticResource SectionTitle}" Margin="0" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Bars}" Height="84" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ChartBar}">
                                    <Grid Margin="1,0" Background="Transparent" ToolTip="{Binding ToolTip}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="{Binding Rest}" />
                                            <RowDefinition Height="{Binding Agents}" />
                                            <RowDefinition Height="{Binding People}" />
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="1" Background="{StaticResource AgentActivityBrush}" CornerRadius="1" />
                                        <Border Grid.Row="2" Background="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="1" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Height="1" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />
                        <ItemsControl ItemsSource="{Binding Bars}" Focusable="False" Margin="0,3,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ChartBar}">
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource MutedText}" FontSize="10" HorizontalAlignment="Center" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="What" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding Kinds}" ItemTemplate="{StaticResource StatBarRow}" Focusable="False" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,16,0,0">
                        <TextBlock Text="Where" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding Projects}" ItemTemplate="{StaticResource StatBarRow}" Focusable="False" />
                        <TextBlock Text="{Binding MoreProjects}" Style="{StaticResource MutedText}" Margin="0,2,0,0"
                                   Visibility="{Binding MoreProjects, Converter={StaticResource EmptyToVis}}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,16,0,0">
                        <TextBlock Text="Who" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding Who}" ItemTemplate="{StaticResource StatBarRow}" Focusable="False" />
                        <TextBlock Text="{Binding MoreWho}" Style="{StaticResource MutedText}" Margin="0,2,0,0"
                                   Visibility="{Binding MoreWho, Converter={StaticResource EmptyToVis}}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </DataTemplate>
</ResourceDictionary>
